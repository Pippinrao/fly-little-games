  "platformResourceNameOverrides": {
    "nearby.open": {
      "harmony": "nearby_open_entry",
      "note": "HarmonyOS already has nearby_open ('附近') from the first-version UI whose value must not change; the contract string gets a distinct resource name."
    }
  },
  "categoryAliases": {
    "category.recent": { "zh": "最近", "android": "category_recent", "harmony": "game_center_recent", "ios": "game_center.recent" },
    "category.favorites": { "zh": "收藏", "android": "category_favorites", "harmony": "game_center_favorites", "ios": "game_center.favorites" },
    "category.all": { "zh": "全部", "android": "category_all", "harmony": "game_center_all", "ios": "game_center.all" },
    "category.builtin": { "zh": "内置", "android": "category_builtin", "harmony": "game_center_builtin", "ios": "game_center.builtin" }
  },
  "capability": {
    "values": ["SUPPORTED", "UNSUPPORTED", "UNKNOWN"],
    "unknownLabelKey": "nearby.capability.unknown",
    "unknownExcludedWhenFilterOn": true,
    "unknownIsNotUnsupported": true,
    "source": "shared versioned game profile/catalog projection only; never inferred from filename, P2 in the title, or controller count",
    "zeroResultBehavior": {
      "keepsCategory": true,
      "offersAction": "disableMultiplayerFilter"
    }
  },
  "multiplayerFilter": {
    "independentFrom": ["category", "query", "connectionStatus"],
    "default": false,
    "persistedPerDevice": true,
    "connectionEventsDoNotChangeIt": true
  },
  "invite": {
    "codeLength": 6,
    "codeAlphabet": "asciiDigits",
    "leadingZerosPreserved": true,
    "pasteTrimmedWhitespace": true,
    "noSilentTruncation": true,
    "validitySeconds": 60,
    "regenerateInvalidatesOldInviteAndQr": true,
    "qrSingleUse": true,
    "lateCallbacksNeverRevive": true,
    "codeIsNotSecret": "the code only locates a temporary anonymous invitation; it is never a SAS, password, or session key"
  },
  "sas": {
    "digits": 6,
    "labelKey": "nearby.screen.sas",
    "singleSideConfirmInsufficient": true,
    "mismatchCancelsGeneration": true,
    "qrPathSkipsForcedSas": true
  },
  "anonymousCandidate": {
    "allowedFields": ["displayName", "rssi"],
    "forbiddenFields": ["friendNickname", "longTermPublicKey", "stableFingerprint"]
  },
  "permissions": {
    "camera": {
      "requestWhen": "scanQr first use",
      "deniedReasonKey": "nearby.reason.permission.cameraDenied",
      "denialDoesNotDisable": ["enterInviteCode", "findDevices"],
      "repeatPrompt": false
    },
    "nearbyDiscovery": {
      "requestWhen": "entering nearby pages, per stage",
      "deniedReasonKey": "nearby.reason.permission.discoveryDenied",
      "repeatPrompt": false
    },
    "wifi": {
      "requestWhen": "wifi path selected, one system confirmation per session",
      "deniedReasonKey": "nearby.reason.permission.wifiDenied",
      "repeatPrompt": false
    }
  },
  "layout": {
    "unit": "logical dp/vp/pt inside safe area",
    "topBarBasisDp": 64,
    "lobbyDetailWidthRatio": 0.3,
    "lobbyGridWidthRatio": 0.7,
    "nearbySplitMinWidthDp": 580,
    "nearbyLeftColumnWidthDp": 224,
    "nearbyColumnGutterDp": 18,
    "actionMinHitDp": 48,
    "bottomActionMinButtonWidthDp": 160,
    "bottomActionFullWidthForbidden": true,
    "bottomBarIsSeparateRegionFromBody": true,
    "gridToleranceDp": 2,
    "fontScales": [1.0, 1.3, 2.0],
    "qrSquare": true,
    "horizontalScrollAllowedOnlyFor": ["lobbyGameGrid"],
    "colors": {
      "background": "#121316",
      "surface": "#1B1D22",
      "raised": "#292B31",
      "text": "#F4EFE6",
      "muted": "#BEB8AE",
      "primary": "#FF6B5E"
    },
    "colorIsNeverTheOnlyStatusSignal": true
  },
  "pendingConfig": {
    "fields": ["gameIdentity", "host", "seat", "modeResult", "soundLocal", "capabilityPlan"],
    "confirmBindsFullFingerprint": true,
    "uiShortCodeIsDisplayOnly": true,
    "anyChangeInvalidatesBothConfirmations": true,
    "bothConfirmationsRequiredToStart": true
  }
}
