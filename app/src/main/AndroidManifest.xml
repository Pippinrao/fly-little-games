<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Nearby 扫码加入: declared here, requested only when the user opens the scan entry (design 2026-09-13 4.2). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".FlyNesApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:theme="@style/Theme.FlyNES">
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".GameLibraryActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ControlLayoutActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".NearbyFriendsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!--
          配对 and 大厅 are declared because on Android the manifest is the navigation registry: an
          activity missing here cannot be started at all, not even from a page that exists to
          explain why it is blocked. They are deliberately not reachable from 好友/附近设备 yet —
          both sit after discovery, and discovery is blocked at the 权限 stage, so an entry button
          would be a bypass of the very stage model these pages exist to display (spec §4).

          No permission is declared here. D1 is pages-first: each permission is declared in the
          change that first uses it, so adding an unused BLE/camera/Wi-Fi permission now would buy
          nothing and cost store-review risk.
        -->
        <activity
            android:name=".NearbyPairingActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".NearbyLobbyActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".NearbyFriendsManageActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
