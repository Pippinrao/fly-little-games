# Rust provider build outputs (cargo). The crate source is tracked; its
# ~1.3 GB debug/release tree is a local build artifact and must never be
# committed.
/shared/nearby-quic-provider/target/

# Bundled content staged into platform resource directories (generated by
# tools/content/sync-builtin-content.ps1; content/assets is the source of truth)
/harmony/entry/src/main/resources/rawfile/builtin-games.json
/harmony/entry/src/main/resources/rawfile/*.nes
/harmony/entry/src/main/resources/rawfile/concentration_room.txt
/harmony/entry/src/main/resources/rawfile/dabg.txt
/harmony/entry/src/main/resources/rawfile/rhde.txt
/harmony/entry/src/main/resources/rawfile/super_tilt_bro.txt
/harmony/entry/src/main/resources/rawfile/thwaite.txt
/harmony/entry/src/main/resources/rawfile/twin_dragons.txt
/harmony/entry/src/main/resources/rawfile/zap_ruder.txt
/core/tests/fixtures/*.nes

# Local-only developer tools that operate on private ROM collections. They never
# ship and never run in CI; see ios/scripts/local/README.md.
/ios/scripts/local/

# OS
.DS_Store
Thumbs.db
