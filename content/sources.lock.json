  "sources": [
    {
      "canonicalId": "builtin:super-tilt-bro",
      "upstreamRepo": "https://github.com/sgadrat/super-tilt-bro",
      "sourceRevision": "b132fd25add46f816e04be64c434386743b84b8b",
      "sourceTarballSha256": "7daddb9047aef1f74483d37d1ae5cf14fcd8dc654ef12d778b6da1503fd21ae3",
      "buildEnv": "wsl-ubuntu-24.04",
      "buildWorkDir": ".",
      "buildSteps": [
        "./build.sh"
      ],
      "env": {
        "SKIP_RESCUE_IMG": "2"
      },
      "outputRomPath": "tilt_no_network_unrom_(E).nes",
      "assetFilename": "super_tilt_bro.nes",
      "mapper": 2,
      "romSha256": "6f80d56ce0b242a4faceafafea321feb1c364ab8e7937646e8580ae9289a4ec3",
      "notes": "The upstream default ROM uses sgadrat's custom RAINBOW mapper, which no emulator implements. Only the UNROM no-network variant is emulator-usable, so that is what ships. SKIP_RESCUE_IMG=2 skips the Rainbow cartridge recovery partition; verified byte-identical to a full build and cuts the build from ~15 min to ~10 s."
    },
    {
      "canonicalId": "builtin:twin-dragons",
      "upstreamRepo": "https://github.com/Garydos/twin-dragons-nes",
      "sourceRevision": "bcf27d0c5117a2aac19e6c33bdb3c776ada069fb",
      "sourceTarballSha256": "4a011a580f42e2caad7aa911d023cb5e29a559b28764cb3f8aba2bf7f483eaf1",
      "buildEnv": "wsl-ubuntu-24.04",
      "buildWorkDir": "src",
      "buildSteps": [
        "java -jar \"$MILLFORK_JAR\" main.mfk -i ./music -i ./levels -i ./enemies -o ../bin/twin_dragons -t nes_small_v -O1"
      ],
      "outputRomPath": "bin/twin_dragons.nes",
      "assetFilename": "twin_dragons.nes",
      "mapper": 0,
      "romSha256": "dc03a714636b0fd0cf2246475073baba1fcc82ba9d4ac7e55cac5ea8804f0598",
      "notes": "upstream make.bat hardcodes C:\\millfork-0.3.12\\millfork.exe; on Linux the same arguments are passed to the Millfork jar. Pin Millfork to 0.3.12: the README states the 32 KiB PRG space is completely full, so a newer compiler risks overflow."
    },
    {
      "canonicalId": "builtin:rhde",
      "upstreamRepo": "https://github.com/pinobatch/rhde-nes",
      "sourceRevision": "376204907155d15bb13018e5f9b231c8511d5333",
