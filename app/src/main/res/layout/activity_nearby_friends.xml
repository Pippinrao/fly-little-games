<?xml version="1.0" encoding="utf-8"?>
<!--
  好友 / 附近设备 — one page, two tabs (decision D13), single column: tabs on top, the selected
  panel below.

  The 附近设备 tab opens with the discovery capability row, then the §2.1 pairing pipeline, then the
  empty device list. Every stage row's status — and therefore its icon, its name colour, its
  accessibility label and whether its reason is shown — is computed once by
  NearbyStagePipeline.render() from the first failing stage, so neither this layout nor its include
  holds any per-row status of its own. Until the session ABI reports the current stage, 权限 is the
  first failing stage: it is marked (current) and carries its reason, and every later stage uses the
  neutral not-yet-reached treatment with no blocked key and no reason (decision D5). No stage
  precedes 权限, so no row renders in the passed treatment yet; that treatment is a live code path
  and keeps its key (nearby_stage_status_passed) for when the session reports a later first failure.

  The discovery capability row below is a separate element from the pipeline's 发现 row: a
  capability row names the stage that blocks it, its reason, and the disabled control's own
  blocked reason. The two elements are deliberately ordered action-first — emulator instrumentation
  proved the opposite order pushed both controls below the fold (nearby_find_devices at y=972 with
  an empty global visible rect on a landscape phone), so a user had to scroll past seven status rows
  to reach the only thing the 附近设备 tab can do. Order follows `content-priority`.

  The friends list is empty (nearby_friends_empty) and says so with the specific blocked reason
  nearby_blocked_friend_store; no sample friend row is ever inflated. 好友管理 is a real navigation
  row — the only control here that works — and it is disabled-looking only in the sense that its
  target is empty; it must never be replaced by a fake list. Discovery has no bearer, so 寻找设备 /
  扫描房主二维码 are present but disabled, each with the visible nearby_blocked_discovery reason.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearby_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fly_background" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/nearby_toolbar"
        android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/fly_surface"
        android:minHeight="48dp" app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/fly_on_surface"
        app:title="@string/nearby_title" app:titleTextColor="@color/fly_on_surface" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:padding="@dimen/fly_space_2">
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/nearby_tabs" android:layout_width="wrap_content" android:layout_height="48dp" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/nearby_tab_friends" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="96dp" android:text="@string/nearby_tab_friends" android:textColor="@color/fly_on_surface" />
            <com.google.android.material.button.MaterialButton android:id="@+id/nearby_tab_devices" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="96dp" android:text="@string/nearby_tab_devices" android:textColor="@color/fly_on_surface" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/fly_space_2" android:layout_weight="1">
            <ScrollView android:id="@+id/nearby_friends_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fly_surface" android:fillViewport="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/fly_space_4">
                    <TextView android:id="@+id/nearby_friends_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nearby_friends_empty" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/fly_on_surface" />
                    <TextView android:id="@+id/nearby_friends_blocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fly_space_2" android:text="@string/nearby_blocked_friend_store" android:textColor="@color/fly_error" />
                    <!--
                      The saved-friends explanation states the rule the friend store will follow
                      rather than implying that friends are lost: a friend record is written after
                      authentication, and it grants nothing by itself (design §22.1).
                    -->
                    <TextView android:id="@+id/nearby_friends_saved_after_auth" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fly_space_4" android:text="@string/nearby_friends_saved_after_auth" android:textColor="@color/fly_on_surface_muted" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/nearby_friends_manage" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/fly_space_4" android:text="@string/nearby_friends_manage" />
                </LinearLayout>
            </ScrollView>
            <ScrollView android:id="@+id/nearby_devices_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fly_surface" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/fly_space_4">
                    <LinearLayout android:id="@+id/nearby_discovery_stage_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
                        <ImageView android:id="@+id/nearby_discovery_stage_status" android:layout_width="@dimen/fly_icon_medium" android:layout_height="@dimen/fly_icon_medium" android:contentDescription="@null" android:src="@drawable/ic_stage_failed" app:tint="@color/fly_error" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/fly_space_2" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/nearby_discovery_stage_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nearby_stage_discovery" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/fly_on_surface" />
                            <TextView android:id="@+id/nearby_discovery_stage_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nearby_stage_discovery_reason" android:textColor="@color/fly_error" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/nearby_find_devices" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/fly_space_4" android:enabled="false" android:text="@string/nearby_find_devices" />
                    <TextView android:id="@+id/nearby_find_devices_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fly_space_1" android:text="@string/nearby_blocked_discovery" android:textColor="@color/fly_error" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/nearby_scan_host_qr" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/fly_space_3" android:enabled="false" android:text="@string/nearby_scan_host_qr" />
                    <TextView android:id="@+id/nearby_scan_host_qr_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fly_space_1" android:text="@string/nearby_blocked_discovery" android:textColor="@color/fly_error" />
                    <!--
                      The one navigate-only entry §4 permits besides the game-center entry: the 配对
                      page must exist to display the six-digit-code and Wi-Fi stages with the stage
                      that blocks them, and this is how a user reaches it while discovery is blocked.
                      It sits with the other actions, above the explanatory pipeline, so the user
                      does not have to scroll past seven status rows to find it — the same
                      `content-priority` reason that put the discovery row first. It is labelled with
                      the page's own name, not the feature's, so nobody reads it as "start pairing
                      now". 大厅 gets no such entry: §4 permits the exception only into 配对, and
                      大厅 sits after pairing completes.
                    -->
                    <com.google.android.material.button.MaterialButton android:id="@+id/nearby_open_pairing" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/fly_space_3" android:text="@string/nearby_pairing_title" />
                    <include layout="@layout/view_nearby_stage_pipeline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fly_space_6" />
                    <TextView android:id="@+id/nearby_devices_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fly_space_6" android:text="@string/nearby_devices_empty" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/fly_on_surface" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
