<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/display_settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/display_quality_title"
            android:textColor="@color/fly_on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/display_quality_subtitle"
            android:textColor="@color/fly_on_surface_muted"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/video_preset_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/video_preset_power_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="88dp"
                    app:cardBackgroundColor="@color/fly_surface_variant"
                    app:cardCornerRadius="16dp"
                    app:rippleColor="@color/fly_outline_soft"
                    app:strokeColor="@color/fly_outline_soft"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <RadioButton android:id="@+id/video_preset_power" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:minHeight="48dp"
                            android:text="@string/video_preset_power" android:textColor="@color/fly_on_surface"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/video_preset_power_summary"
                            android:textColor="@color/fly_on_surface_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/video_preset_balanced_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="88dp"
                    app:cardBackgroundColor="@color/fly_surface_variant"
                    app:cardCornerRadius="16dp"
                    app:rippleColor="@color/fly_outline_soft"
                    app:strokeColor="@color/fly_outline_soft"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <RadioButton android:id="@+id/video_preset_balanced" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:minHeight="48dp"
                            android:text="@string/video_preset_balanced" android:textColor="@color/fly_on_surface"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/video_preset_balanced_summary"
                            android:textColor="@color/fly_on_surface_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/video_preset_extreme_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="88dp"
                    app:cardBackgroundColor="@color/fly_surface_variant"
                    app:cardCornerRadius="16dp"
                    app:rippleColor="@color/fly_outline_soft"
                    app:strokeColor="@color/fly_outline_soft"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <RadioButton android:id="@+id/video_preset_extreme" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:minHeight="48dp"
                            android:text="@string/video_preset_extreme_locked" android:textColor="@color/fly_on_surface_muted"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/video_preset_extreme_summary"
                            android:textColor="@color/fly_on_surface_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/video_preset_custom_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="88dp"
                    app:cardBackgroundColor="@color/fly_surface_variant"
                    app:cardCornerRadius="16dp"
                    app:rippleColor="@color/fly_outline_soft"
                    app:strokeColor="@color/fly_outline_soft"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <RadioButton android:id="@+id/video_preset_custom" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:minHeight="48dp"
                            android:text="@string/video_preset_custom" android:textColor="@color/fly_on_surface"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/video_preset_custom_summary"
                            android:textColor="@color/fly_on_surface_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </RadioGroup>

        <LinearLayout
            android:id="@+id/video_custom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/fly_surface_variant"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/video_custom_axes" android:textColor="@color/fly_on_surface"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/refresh_rate"
                android:textColor="@color/fly_on_surface_muted" />
            <Spinner android:id="@+id/video_refresh_spinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/refresh_rate" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/video_temporal_mode"
                android:textColor="@color/fly_on_surface_muted" />
            <Spinner android:id="@+id/video_temporal_spinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/video_temporal_mode" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/video_spatial_mode"
                android:textColor="@color/fly_on_surface_muted" />
            <Spinner android:id="@+id/video_spatial_spinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/video_spatial_mode" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/video_post_effect"
                android:textColor="@color/fly_on_surface_muted" />
            <Spinner android:id="@+id/video_post_spinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/video_post_effect" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/aspect_mode"
                android:textColor="@color/fly_on_surface_muted" />
            <Spinner android:id="@+id/video_aspect_spinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:contentDescription="@string/aspect_mode" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/video_adaptive_protection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/video_adaptive_protection"
            android:textColor="@color/fly_on_surface" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/fly_surface_variant"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/fly_outline_soft"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/video_runtime_status" android:textColor="@color/fly_on_surface"
                    android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/video_status_request" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textColor="@color/fly_on_surface" android:textSize="14sp" />
                <TextView android:id="@+id/video_status_protection" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@color/fly_on_surface_muted" android:textSize="14sp" />
                <TextView android:id="@+id/video_status_system" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@color/fly_on_surface_muted" android:textSize="14sp" />
                <TextView android:id="@+id/video_status_runtime" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@color/fly_on_surface_muted" android:textSize="14sp" />
                <TextView android:id="@+id/video_status_evidence" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@color/fly_secondary" android:textSize="14sp" />
                <TextView android:id="@+id/video_status_power" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@color/fly_on_surface_muted" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/display_frames_note"
                    android:textColor="@color/fly_on_surface_muted" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
