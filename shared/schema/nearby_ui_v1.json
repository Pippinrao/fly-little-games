{
  "contractId": "flynes-nearby-ui-v1",
  "description": "Application UI contract for the approved nearby multiplayer UX (design docs/superpowers/specs/2026-09-13-nearby-ui-parity-design.md). This is a product UI contract shared by Android, HarmonyOS NEXT and iOS - it is NOT a wire protocol, encodes no network success results, no credentials, and no device identities. The screen/reason/string identifiers here must stay in sync with shared/include/flynes/product/nearby_ui_state.hpp; tools/quality/check_nearby_ui_contract.py enforces platform string coverage and Chinese text equality.",
  "statusFields": [
    "connectionStatus",
    "screenId",
    "stage",
    "failureReason",
    "verifiedPeer",
    "actions",
    "pendingConfigId",
    "generation"
  ],
  "connectionStatuses": {
    "unknown": {
      "entryKey": "nearby.entry.unavailable"
    },
    "disconnected": {
      "entryKey": "nearby.open"
    },
    "pairing": {
      "entryKey": "nearby.open"
    },
    "connected": {
      "entryKey": "nearby.entry.connected"
    },
    "interrupted": {
      "entryKey": "nearby.entry.interrupted"
    }
  },
  "entryRule": {
    "connectedRequiresAll": [
      "connectionEstablished",
      "peerVerified",
      "channelBound",
      "compatibilityVerified"
    ],
    "interruptedRequiresAll": [
      "previousConnectionEstablished",
      "reconnecting"
    ],
    "insufficientFactsProjectUnavailable": true,
    "neverConnectedFrom": [
      "scanSuccess",
      "hostAcceptance",
      "correctInviteCode",
      "singleSideSasConfirm",
      "persistedBoolean",
      "elapsedTime",
      "pagePath",
      "testFlag"
    ]
  },
  "stages": {
    "order": [
      "permissions",
      "discovery",
      "authentication",
      "wifi",
      "quic",
      "version",
      "codec"
    ],
    "states": [
      "notStarted",
      "inProgress",
      "passed",
      "failed"
    ],
    "failurePolicy": "Show only the first failed stage with its reason; earlier stages render as passed; stages after the first failure render as notStarted and must never be rendered as failed. A timeline contradicting this is invalid and renders nearby.stage.timeline.invalid instead of any success-looking state."
  },
  "screens": {
    "N00": {
      "titleKey": "nearby.screen.entry",
      "requiresSelectedGame": false,
      "actions": [
        "createInvite",
        "enterInviteCode",
        "scanQr",
        "findDevices",
        "openFriends",
        "backToGameCenter"
      ],
      "tabs": ["nearby.tab.devices", "nearby.tab.friends"]
    },
    "N01": {
      "titleKey": "nearby.screen.invite",
      "requiresSelectedGame": false,
      "actions": ["regenerateInvite", "cancelInvite"],
      "content": ["nearby.invite.codeLabel", "nearby.invite.qrLabel", "nearby.invite.validFor"]
    },
    "N02": {
      "titleKey": "nearby.screen.joinCode",
      "requiresSelectedGame": false,
      "actions": ["submitJoinCode", "switchToScan", "cancelRequest"],
      "content": ["nearby.join.codeLabel"],
      "fieldErrorPlacement": "adjacentToInput"
    },
    "N03": {
      "titleKey": "nearby.screen.scan",
      "requiresSelectedGame": false,
      "actions": ["switchToJoinCode", "cancel"]
    },
    "N04": {
      "titleKey": "nearby.screen.waitHost",
      "requiresSelectedGame": false,
      "actions": ["cancelRequest"],
      "content": ["nearby.wait.anonymousNote"]
    },
    "N05": {
      "titleKey": "nearby.screen.hostRequest",
      "requiresSelectedGame": false,
      "actions": ["acceptRequest", "rejectRequest"],
      "content": ["nearby.host.anonymousTitle", "nearby.host.sourceNote"]
    },
    "N06": {
      "titleKey": "nearby.screen.sas",
      "requiresSelectedGame": false,
      "actions": ["confirmSasMatch", "reportSasMismatch"],
      "content": ["nearby.sas.digitCount"]
    },
    "N07": {
      "titleKey": "nearby.screen.connecting",
      "requiresSelectedGame": false,
      "actions": ["cancelConnecting", "viewDetails"],
      "content": ["nearby.connecting.stageLabel", "nearby.connecting.wifiPath"]
    },
    "N08": {
      "titleKey": "nearby.screen.connected",
      "requiresSelectedGame": false,
      "actions": ["goToGameCenter", "disconnect"],
      "content": ["nearby.connected.friendLabel", "nearby.connected.shortCodeLabel"]
    },
    "G00": {
      "titleKey": "nearby.screen.gameCenter",
      "requiresSelectedGame": false,
      "actions": ["openNearby", "selectGame", "disableMultiplayerFilter"],
      "categories": ["RECENT", "FAVORITES", "ALL", "BUILTIN"],
      "categoryLabelAliases": {
        "RECENT": "category.recent",
        "FAVORITES": "category.favorites",
        "ALL": "category.all",
        "BUILTIN": "category.builtin"
      }
    },
    "N09": {
      "titleKey": "nearby.screen.gameConfig",
      "requiresSelectedGame": true,
      "actions": ["confirmConfig", "backToLobby"],
      "content": [
        "nearby.config.hostLabel",
        "nearby.config.seatLabel",
        "nearby.config.soundLabel",
        "nearby.config.shortCodeLabel",
        "nearby.config.waitingConfirm",
        "nearby.config.confirmed"
      ]
    },
    "N10": {
      "titleKey": "nearby.screen.failure",
      "requiresSelectedGame": false,
      "actions": ["retry", "newInvite", "backToEntry"],
      "content": ["nearby.failure.stageLabel", "nearby.failure.reasonLabel"]
    },
    "N11": {
      "titleKey": "nearby.screen.content",
      "requiresSelectedGame": false,
      "actions": ["grantSend", "grantReceive", "confirmImport", "cancelTransfer"]
    },
    "N12": {
      "titleKey": "nearby.screen.friends",
      "requiresSelectedGame": false,
      "actions": ["renameFriend", "deleteFriend", "blockFriend", "resetIdentity"]
    }
  },
  "actions": {
    "createInvite": { "labelKey": "nearby.action.create" },
    "enterInviteCode": { "labelKey": "nearby.action.enterCode" },
    "scanQr": { "labelKey": "nearby.action.scanQr", "permission": "camera", "requestPolicy": "onFirstUseOnly" },
    "findDevices": { "labelKey": "nearby.action.findDevices", "permission": "nearbyDiscovery" },
    "openFriends": { "labelKey": "nearby.action.openFriends" },
    "backToGameCenter": { "labelKey": "nearby.action.backToGameCenter" },
    "regenerateInvite": { "labelKey": "nearby.action.regenerate", "invalidatesOldInviteAndQr": true },
    "cancelInvite": { "labelKey": "nearby.action.cancelInvite", "invalidatesOldInviteAndQr": true },
    "submitJoinCode": {
      "labelKey": "nearby.action.submitJoinCode",
      "requires": ["joinCodeComplete"],
      "forbiddenWhile": ["joinRequestInFlight"]
    },
    "switchToScan": { "labelKey": "nearby.action.switchToScan", "permission": "camera" },
    "switchToJoinCode": { "labelKey": "nearby.action.switchToJoinCode" },
    "cancel": { "labelKey": "nearby.action.cancel" },
    "cancelRequest": { "labelKey": "nearby.action.cancelRequest" },
    "acceptRequest": { "labelKey": "nearby.action.accept" },
    "rejectRequest": { "labelKey": "nearby.action.reject" },
    "confirmSasMatch": { "labelKey": "nearby.action.sasMatch" },
    "reportSasMismatch": { "labelKey": "nearby.action.sasMismatch", "cancelsGeneration": true },
    "cancelConnecting": { "labelKey": "nearby.action.cancelConnecting" },
    "viewDetails": { "labelKey": "nearby.action.viewDetails" },
    "goToGameCenter": { "labelKey": "nearby.action.goToGameCenter" },
    "disconnect": { "labelKey": "nearby.action.disconnect" },
    "openNearby": { "labelKey": "nearby.action.openNearby" },
    "selectGame": {
      "labelKey": "nearby.action.selectGame",
      "connectedBehavior": "proposeCurrentGameIntoConfig",
      "soloBehavior": "originalSoloPath"
    },
    "disableMultiplayerFilter": { "labelKey": "nearby.action.disableMultiplayerFilter", "keepsCategory": true },
    "confirmConfig": { "labelKey": "nearby.action.confirmConfig", "bindsPendingConfigFingerprint": true },
    "backToLobby": { "labelKey": "nearby.action.backToLobby", "keepsConnection": true, "invalidatesConfigConfirm": true },
    "retry": { "labelKey": "nearby.action.retry" },
    "newInvite": { "labelKey": "nearby.action.newInvite" },
    "backToEntry": { "labelKey": "nearby.action.backToEntry" },
    "grantSend": { "labelKey": "nearby.action.grantSend" },
    "grantReceive": { "labelKey": "nearby.action.grantReceive" },
    "confirmImport": { "labelKey": "nearby.action.confirmImport", "receiverOnly": true },
    "cancelTransfer": { "labelKey": "nearby.action.cancelTransfer" },
    "renameFriend": { "labelKey": "nearby.action.renameFriend" },
    "deleteFriend": { "labelKey": "nearby.action.deleteFriend" },
    "blockFriend": { "labelKey": "nearby.action.blockFriend" },
    "resetIdentity": { "labelKey": "nearby.action.resetIdentity" }
  },
