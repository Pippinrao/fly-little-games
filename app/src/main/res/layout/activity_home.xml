<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/home_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fly_background" android:orientation="vertical">
    <LinearLayout android:id="@+id/game_center_topbar" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/game_center_heading" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="16dp" android:text="@string/game_center_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/fly_on_surface" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/category_tabs" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/category_recent" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="72dp" android:text="@string/category_recent" android:textColor="@color/game_center_tab_text" app:backgroundTint="@color/game_center_tab_background" />
            <com.google.android.material.button.MaterialButton android:id="@+id/category_favorites" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="72dp" android:text="@string/category_favorites" android:textColor="@color/game_center_tab_text" app:backgroundTint="@color/game_center_tab_background" />
            <com.google.android.material.button.MaterialButton android:id="@+id/category_all" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="72dp" android:text="@string/category_all" android:textColor="@color/game_center_tab_text" app:backgroundTint="@color/game_center_tab_background" />
            <com.google.android.material.button.MaterialButton android:id="@+id/category_builtin" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="72dp" android:text="@string/category_builtin" android:textColor="@color/game_center_tab_text" app:backgroundTint="@color/game_center_tab_background" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <com.google.android.material.button.MaterialButton android:id="@+id/open_search" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/search_games" app:icon="@drawable/ic_search" app:iconTint="@color/fly_on_surface" />
        <com.google.android.material.button.MaterialButton android:id="@+id/open_sources" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/manage_sources" app:icon="@drawable/ic_sources" app:iconTint="@color/fly_on_surface" />
        <com.google.android.material.button.MaterialButton android:id="@+id/open_settings" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/settings" app:icon="@drawable/ic_settings" app:iconTint="@color/fly_on_surface" />
        <com.google.android.material.button.MaterialButton android:id="@+id/open_nearby" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/nearby_open" android:textColor="@color/fly_on_surface" />
    </LinearLayout>
    <LinearLayout android:id="@+id/search_bar" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <EditText android:id="@+id/search_input" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="@color/fly_primary" android:hint="@string/search_games" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" android:textColor="@color/fly_on_surface" android:textColorHint="@color/fly_on_surface_muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/close_search" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/close_search" app:icon="@drawable/ic_close" app:iconTint="@color/fly_on_surface" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/game_center_content" android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/game_detail_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="30" app:cardBackgroundColor="@color/fly_surface" app:cardCornerRadius="20dp" app:strokeColor="@color/fly_outline_soft" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <FrameLayout android:id="@+id/detail_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cartridge">
                        <ImageView android:id="@+id/detail_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                        <TextView android:id="@+id/detail_art_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="16dp" android:textColor="@color/fly_on_surface_muted" android:textStyle="bold" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/detail_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="@color/fly_on_surface" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/favorite_toggle" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/add_favorite" app:icon="@drawable/ic_favorite_outline" app:iconTint="@color/fly_primary" />
                    </LinearLayout>
                    <TextView android:id="@+id/detail_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/fly_on_surface_muted" />
                    <TextView android:id="@+id/detail_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:textColor="@color/fly_on_surface_muted" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/launch_selected" style="@style/Widget.Material3.Button.Icon" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/start_game" android:textColor="@color/fly_on_primary" app:backgroundTint="@color/fly_primary" app:icon="@drawable/ic_play" app:iconTint="@color/fly_on_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="70" android:orientation="vertical">
                <LinearLayout android:id="@+id/library_status_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/library_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:accessibilityLiveRegion="polite" android:gravity="center_vertical" android:maxLines="2" android:minHeight="32dp" android:textColor="@color/fly_on_surface_muted" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/disable_multiplayer_filter" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/nearby_action_disableMultiplayerFilter" android:textColor="@color/fly_primary" android:visibility="gone" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/multiplayer_filter" android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="@string/nearby_filter_multiplayerOnly" android:textColor="@color/fly_on_surface" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/game_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:contentDescription="@string/game_list" android:overScrollMode="ifContentScrolls" android:padding="4dp" android:scrollbars="horizontal" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/source_content" android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false" android:orientation="horizontal" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="34" android:background="@drawable/bg_game_center_selected" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/sources_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sources_heading" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="@color/fly_on_surface" android:textStyle="bold" />
                <ScrollView android:id="@+id/source_copy_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="false" android:paddingBottom="8dp" android:scrollbars="vertical">
                    <TextView android:id="@+id/source_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sources_summary" android:textColor="@color/fly_on_surface_muted" />
                </ScrollView>
                <com.google.android.material.button.MaterialButton android:id="@+id/add_source" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/add_rom_source" android:textColor="@color/fly_on_primary" app:backgroundTint="@color/fly_primary" app:icon="@drawable/ic_add_folder" app:iconTint="@color/fly_on_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="66" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/managed_sources" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/fly_on_surface" android:textStyle="bold" /><com.google.android.material.button.MaterialButton android:id="@+id/close_sources" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/close_sources" app:icon="@drawable/ic_close" app:iconTint="@color/fly_on_surface" /></LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/source_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/managed_sources" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
