<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed landscape grid. Unimplemented actions explain their availability on tap. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearby_manage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fly_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nearby_manage_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fly_background"
        android:minHeight="48dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/fly_on_surface"
        app:title="@string/nearby_friends_manage"
        app:titleTextAppearance="@style/TextAppearance.FlyNes.Nearby.PageTitle"
        app:titleTextColor="@color/fly_on_surface" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.36"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingEnd="24dp">
            <TextView
                android:id="@+id/nearby_manage_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:includeFontPadding="false"
                android:text="@string/nearby_friends_section"
                android:textColor="@color/fly_on_surface"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.PaneTitle" />
            <TextView
                android:id="@+id/nearby_manage_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:includeFontPadding="false"
                android:text="@string/nearby_friends_empty"
                android:textColor="@color/fly_on_surface"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Body" />
            <TextView
                android:id="@+id/nearby_manage_blocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:includeFontPadding="false"
                android:text="@string/nearby_not_supported"
                android:textColor="@color/fly_on_surface"
                android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.64"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginVertical="6dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nearby_manage_rename"
                    style="@style/Widget.FlyNes.Nearby.Action"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/nearby_friends_rename" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nearby_manage_delete"
                    style="@style/Widget.FlyNes.Nearby.Action"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/nearby_friends_delete" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginVertical="6dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nearby_manage_block"
                    style="@style/Widget.FlyNes.Nearby.Action"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/nearby_friends_block" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nearby_manage_identity_reset"
                    style="@style/Widget.FlyNes.Nearby.Action"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/nearby_friends_identity_reset" />
            </LinearLayout>
            <TextView
                android:id="@+id/nearby_manage_rename_reason"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="@string/nearby_not_supported" />
            <TextView
                android:id="@+id/nearby_manage_delete_reason"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="@string/nearby_not_supported" />
            <TextView
                android:id="@+id/nearby_manage_block_reason"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="@string/nearby_not_supported" />
            <TextView
                android:id="@+id/nearby_manage_identity_reset_reason"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="@string/nearby_not_supported" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
