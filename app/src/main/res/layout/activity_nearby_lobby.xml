<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed landscape summary and action rail. Diagnostic fields are paged separately. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearby_lobby_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fly_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/nearby_lobby_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fly_background"
        android:minHeight="48dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/fly_on_surface"
        app:title="@string/nearby_lobby_title"
        app:titleTextAppearance="@style/TextAppearance.FlyNes.Nearby.PageTitle"
        app:titleTextColor="@color/fly_on_surface" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/nearby_lobby_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="16dp" />
        <TextView
            android:visibility="gone"
            android:id="@+id/nearby_lobby_confirm_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:includeFontPadding="false"
            android:text="@string/nearby_blocked_session_read"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.FlyNes.Nearby.Muted"
            android:textColor="@color/fly_on_surface_muted" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fly_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nearby_lobby_details"
            style="@style/Widget.FlyNes.Nearby.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_diagnostics_title" />
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nearby_lobby_confirm"
            style="@style/Widget.FlyNes.Nearby.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:maxWidth="320dp"
            android:minHeight="48dp"
            android:minWidth="200dp"
            android:text="@string/nearby_lobby_confirm"
            android:textAppearance="@style/TextAppearance.FlyNes.Nearby.PrimaryAction" />
    </LinearLayout>
</LinearLayout>
